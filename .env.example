# Copy to .env.local for development or set as real environment variables in production.
# Never commit .env.local or real credentials.

# Public site origin without a trailing slash. Used for canonical URLs, the
# sitemap, robots.txt and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Inquiry email delivery (Resend, https://resend.com) ---------------------
# Without these three values the quote and contact forms show a clear
# "not available" error with the phone number instead of pretending to send.
RESEND_API_KEY=
# Inbox(es) that receive quote requests and contact messages. Comma-separate several.
INQUIRY_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "JMSWORLD Website <website@example.com>"
INQUIRY_FROM_EMAIL=

# --- Optional -----------------------------------------------------------------
# Google Maps Embed API key for the map on the Contact page. Restrict the key to
# your domain in Google Cloud Console (it is public by design). Leave empty to
# show the address panel with a directions link instead of an embedded map.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
